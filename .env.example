# Shell variables for Forge manifest interpolation. Use IDs issued by forge register.
AEGISPR_BITBUCKET_APP_ID=
AEGISPR_JIRA_APP_ID=
# Optional Forge runtime variable for Jira issue navigation. Use a hostname only.
AEGISPR_JIRA_SITE=

# Optional workspace settings. Use a private .env or environment variables.
# V2_ALLOWED_REPOSITORIES=owner/public-repository
# API_ACCESS_TOKEN=replace-with-an-operator-generated-code
# V2_ENABLE_MODELS=false
# V2_BUDGET_USD=1
# V2_RUN_BUDGET_USD=0.03
# V2_MAX_CALLS=3
